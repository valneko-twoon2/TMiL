{
  "name": "taskmanagerlite",
  "version": "0.1.0",
  "private": true,
  "description": "Rust + Tauri + Svelte 5 で作る軽量タスクマネージャー",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node ../../scripts/setup/install-hooks.mjs",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "tauri": "node ../../scripts/dev/tauri.mjs",
    "lint": "node ../../scripts/lint/lint.mjs",
    "lint:fix": "node ../../scripts/lint/lint.mjs --fix",
    "test": "node ../../scripts/test/all.mjs",
    "test:related": "node ../../scripts/test/related.mjs",
    "test:front": "vitest run",
    "test:front:coverage": "vitest run --coverage",
    "test:back": "node ../../scripts/test/backend.mjs",
    "test:back:coverage": "node ../../scripts/test/backend.mjs --coverage",
    "test:tools": "node ../../scripts/test/tools.mjs",
    "test:installer": "node ../../scripts/test/installer.mjs",
    "test:e2e:mock": "playwright test --project=e2e-mock",
    "test:vrt": "playwright test --project=vrt",
    "vrt:pull": "node ../../scripts/test/vrt-pull.mjs",
    "test:e2e:native": "node ../../scripts/test/e2e-native.mjs",
    "test:fuzz": "node ../../scripts/test/fuzz.mjs",
    "test:formal": "node ../../scripts/test/formal.mjs",
    "test:mutation": "node ../../scripts/test/mutation.mjs",
    "docs:tests": "node ../../scripts/docs/test-inventory.mjs",
    "release:bump": "node ../../scripts/release/bump-version.mjs",
    "clean": "node ../../scripts/maintenance/clean.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "selenium-webdriver": "^4.54.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
