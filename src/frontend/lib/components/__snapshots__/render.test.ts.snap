exports[`画面部品 > snapshot > 設定 1`] = `"<!--[--><header class="page-header svelte-6k6ikh"><h1 class="svelte-6k6ikh">設定</h1> <!--[-1--><!--]--></header><!----> <div class="settings svelte-uox2e7"><section class="svelte-uox2e7"><h2 class="svelte-uox2e7">既定のページ</h2> <select aria-label="既定のページ" class="svelte-uox2e7"><!--[--><option value="processes" selected="">プロセス</option><option value="performance">パフォーマンス</option><option value="history">アプリの履歴</option><option value="startup">スタートアップ アプリ</option><option value="users">ユーザー</option><option value="details">詳細</option><option value="services">サービス</option><option value="resmon">リソース モニター</option><!--]--></select></section> <section class="svelte-uox2e7"><h2 class="svelte-uox2e7">リアルタイム更新の速度</h2> <div class="options svelte-uox2e7" role="radiogroup" aria-label="リアルタイム更新の速度"><!--[--><label class="svelte-uox2e7"><input type="radio" name="refresh" value="high"/> 高（0.5 秒）</label><label class="svelte-uox2e7"><input type="radio" name="refresh" value="normal" checked=""/> 標準（1 秒）</label><label class="svelte-uox2e7"><input type="radio" name="refresh" value="low"/> 低（4 秒）</label><label class="svelte-uox2e7"><input type="radio" name="refresh" value="paused"/> 一時停止</label><!--]--></div></section> <section class="svelte-uox2e7"><h2 class="svelte-uox2e7">テーマ</h2> <div class="options svelte-uox2e7" role="radiogroup" aria-label="テーマ"><!--[--><label class="svelte-uox2e7"><input type="radio" name="theme" value="system" checked=""/> システム設定に合わせる</label><label class="svelte-uox2e7"><input type="radio" name="theme" value="light"/> ライト</label><label class="svelte-uox2e7"><input type="radio" name="theme" value="dark"/> ダーク</label><!--]--></div></section> <section class="svelte-uox2e7"><h2 class="svelte-uox2e7">ウィンドウの管理</h2> <label class="svelte-uox2e7"><input type="checkbox"/> 常に手前に表示</label></section> <section class="svelte-uox2e7"><h2 class="svelte-uox2e7">その他のオプション</h2> <label class="svelte-uox2e7"><input type="checkbox" checked=""/> 効率モードを適用する