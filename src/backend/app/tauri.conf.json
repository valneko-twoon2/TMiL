{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMiL",
  "version": "../../../package.json",
  "identifier": "io.github.valneko-twoon2.tmil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TMiL",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "軽量タスクマネージャー",
    "longDescription": "Rust と Tauri で作った、Windows と Linux で動く軽量なタスクマネージャーです。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
